
name: Build TouchX Redmi15 Safe APK

on:
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - 'TouchX-Redmi15-safe-v0.3.1-source.zip'
      - '.github/workflows/main.yml'

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Unpack sources
        run: |
          test -f TouchX-Redmi15-safe-v0.3.1-source.zip
          mkdir -p redmi15_build
          unzip -q TouchX-Redmi15-safe-v0.3.1-source.zip -d redmi15_build
          test -f redmi15_build/TouchX-Redmi15/settings.gradle
          test -f redmi15_build/TouchX-Redmi15/app/build.gradle

      - name: Setup Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Android SDK
        uses: android-actions/setup-android@v4
        with:
          packages: platform-tools

      - name: Install SDK 35
        run: |
          sdkmanager 'platforms;android-35' 'build-tools;35.0.0'

      - name: Setup Gradle 8.9
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Compile debug APK
        working-directory: redmi15_build/TouchX-Redmi15
        run: |
          gradle --no-daemon :app:assembleDebug --stacktrace

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: TouchX-Redmi15-v0.3.1-debug-APK
          path: redmi15_build/TouchX-Redmi15/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
